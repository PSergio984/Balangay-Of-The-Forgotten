  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Nuno sa Punso
        icon: {fileID: 0}
        animatedPortraitPrefab: {fileID: 1114359062913147111, guid: 321c4266e4bc3d74a96a467dd1c649e0, type: 3}
      line: Nabuo mo ang lahat ng pira-pirasong alaala, at sa paglagas ng huling
        dilim, winakasan mo ang pamamayani ng anino.
      typingSpeed: 0.05
      overlayImageObject: {fileID: 560800129}
      overlayDuration: 0
      overlayFadeDuration: 0.3
    - character:
        name: Nuno sa Punso
        icon: {fileID: 0}
        animatedPortraitPrefab: {fileID: 659438599}
      line: Ngayon, nagwawakas ang ating paglalakbay. Ihahatid na kita pabalik sa
        iyong mundo, bitbit ko ang isang paalam na puno ng pasasalamat at pag-asa.
      typingSpeed: 0.05
      overlayImageObject: {fileID: 0}
      overlayDuration: 0
      overlayFadeDuration: 0.3
    onCompleteEventName: Post Final Boss
    dialogueType: 3
